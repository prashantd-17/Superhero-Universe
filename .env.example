# Owner-confirmed production URL. These values belong in Render's Environment settings.
SITE_URL=https://superhero-universe.onrender.com

# Recommended on Render. For local development, omit this override so the built-in
# localhost and Arena preview host allowlist remains enabled.
# NG_ALLOWED_HOSTS=superhero-universe.onrender.com

# Optional: the PUBLIC content value from Search Console's HTML verification tag.
# Do not put an account password, OAuth token or API key here.
# GOOGLE_SITE_VERIFICATION=

# Local default only; Render supplies PORT automatically.
PORT=4000
